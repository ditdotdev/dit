{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "PublicReadForDatadatdatDockerProxy",
            "Effect": "Allow",
            "Principal": "*",
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::datadatdat-maven/datadatdat-docker-proxy/*"
        },
        {
            "Sid": "PublicReadForOldMavenRepository",
            "Effect": "Allow",
            "Principal": "*",
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::datadatdat-maven/io/*"
        },
        {
            "Sid": "PublicReadForDatadatdatMavenRepository",
            "Effect": "Allow",
            "Principal": "*",
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::datadatdat-maven/com/datadatdat/*"
        }
    ]
}
